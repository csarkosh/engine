{
  "name": "@csarkosh/engine",
  "version": "0.2.39",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "exports": {
    "./package.json": "./package.json",
    "./testing/*": "./testing/*.ts",
    "./vite/*": "./vite/*.mjs",
    "./*": "./src/*.ts"
  },
  "workspaces": [
    "server"
  ],
  "files": [
    "src",
    "assets",
    "public",
    "vite",
    "testing",
    "tools",
    "!tools/**/test",
    "!tools/vitest.config.mjs",
    "!tools/new-game.mjs",
    "!**/node_modules",
    "CREDITS.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p . --noEmit && tsc -p empty --noEmit && tsc -p server --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:tools": "vitest run --root tools",
    "test:empty": "vitest run --root empty",
    "test:server": "vitest run --root server",
    "dev:empty": "vite empty",
    "build:empty": "vite build empty",
    "kernel:build": "node tools/rust/build.mjs",
    "kernel:check": "node tools/rust/build.mjs --check",
    "vendor:ktx2": "node tools/vendor-ktx2.mjs",
    "new-game": "node tools/new-game.mjs",
    "pack": "npm pack"
  },
  "dependencies": {
    "@babylonjs/lite": "github:csarkosh/babylon-lite#v1.39.3-dayhike.12"
  },
  "devDependencies": {
    "@babylonjs/ktx2decoder": "9.18.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
